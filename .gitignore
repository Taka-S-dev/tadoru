# Allowlist: ignore everything, then bring back only the files the repository is made of
*
!.gitignore
!Cargo.toml
!Cargo.lock
!README.md
!README.ja.md
!LICENSE
!src/
!src/**
!tests/
!tests/**
!examples/
!examples/**
!.github/
!.github/**
!docs/
!docs/guide/
!docs/guide/**

# Denied again by name, after the allowlist
target/
# Design notes stay private. docs/ itself has to be allowed to reach docs/guide,
# so the files directly under it are denied by name
docs/*.md
docs/*/
!docs/guide/
# Screen captures. docs/*/ closed the folder above, so it is opened again by name here
!docs/images/
!docs/images/**
.env
.env.*
secrets.*
credentials.*
*.pem
id_rsa*
# Other SSH key formats, and certificate, keystore and credential files
id_dsa*
id_ecdsa*
id_ed25519*
*.key
*.p12
*.pfx
*.jks
*.keystore
.netrc
.npmrc
